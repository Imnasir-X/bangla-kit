{
  "name": "bangla-kit",
  "version": "0.1.0",
  "description": "Accurate, zero-dependency Bangla utilities: number to words, taka cheque text, lakh/crore formatting, digit conversion, text cleanup and the Bangladesh calendar.",
  "license": "MIT",
  "author": "Nasir Khan (https://github.com/Imnasir-X)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Imnasir-X/bangla-kit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Imnasir-X/bangla-kit#readme",
  "bugs": "https://github.com/Imnasir-X/bangla-kit/issues",
  "keywords": [
    "bangla",
    "bengali",
    "bangladesh",
    "number-to-words",
    "taka",
    "lakh",
    "crore",
    "bangabda",
    "calendar",
    "i18n"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
